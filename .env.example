DATABASE_URL=postgresql+psycopg://postgres:tu_password@localhost:5432/sistemasyntri
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password
POSTGRES_DB=sistemasyntri
SECRET_KEY=tu_clave_secreta
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
DISCORD_BOT_TOKEN=tu_token
DISCORD_CHANNEL_ID=tu_channel_id
TELEGRAM_BOT_TOKEN=tu_token_de_botfather
TELEGRAM_CHAT_ID=tu_chat_id
ENVIRONMENT=development
# Opcionales: si no se definen, el admin inicial se crea con
# admin@syntri.local / admin123 la primera vez que arranca la app
ADMIN_EMAIL=admin@syntri.local
ADMIN_PASSWORD=admin123
# URLs del frontend en producción, separadas por coma (además de los localhost de desarrollo)
FRONTEND_ORIGINS=https://tu-frontend.vercel.app
# Envío de emails (recuperación de contraseña) vía la API de Brevo
BREVO_API_KEY=tu_api_key_de_brevo
BREVO_FROM_EMAIL=tu_email_verificado@ejemplo.com
BREVO_FROM_NAME=System Syntri
